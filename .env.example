FLASK_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=false
SECRET_KEY=churn-secret-key-change-in-production-2026
HOST=127.0.0.1
PORT=5000

# ── Database & Artifacts ─────────────────────────────────────────────
DATABASE_PATH=database/churn_system.db
